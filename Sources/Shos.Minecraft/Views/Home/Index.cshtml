@{
    ViewData["Title"] = "Shos.Minecraft";
}

<div id="game-container">
    <canvas id="game-canvas"></canvas>
    <div id="game-ui" aria-hidden="true"></div>
</div>

@section Scripts {
    <script src="https://cdn.babylonjs.com/babylon.js"></script>
    <script src="~/js/world/BlockTypes.js" asp-append-version="true"></script>
    <script src="~/js/world/Chunk.js" asp-append-version="true"></script>
    <script src="~/js/world/ChunkMeshBuilder.js" asp-append-version="true"></script>
    <script src="~/js/world/WorldClient.js" asp-append-version="true"></script>
    <script src="~/js/game.js" asp-append-version="true"></script>
}
